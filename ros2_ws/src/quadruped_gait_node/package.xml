<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quadruped_gait_node</name>
  <version>0.0.1</version>
  <description>Gait node for quadruped robot that contains walk and trot</description>
  <maintainer email="michal.sadecki@proton.me">misadecki</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>quadruped_gait</depend>
  <depend>quadruped_config</depend>
  <depend>sensor_msgs</depend>
  <depend>quadruped_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
