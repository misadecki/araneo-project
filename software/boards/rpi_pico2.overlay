/ {
  aliases {
    display0 = &oled;
  };
  chosen {
    zephyr,display = &oled;
  };
};

&pinctrl {
  i2c0_default: i2c0_default {
    group1 {
      pinmux = <I2C0_SDA_P16>, <I2C0_SCL_P17>;
      bias-pull-up;
      input-enable;
      input-schmitt-enable;
    };
  };
};

&i2c0 {
  status = "okay";
  clock-frequency = <I2C_BITRATE_FAST>;
  pinctrl-0 = <&i2c0_default>;
  pinctrl-names = "default";

  oled: oled@3c {
    status = "okay";
    compatible="solomon,ssd1306";
    reg = <0x3c>;
    height = <64>;
    width = <128>;
    com-invdir;
    segment-remap;
    page-offset = <0>;
    segment-offset = <0>;
    display-offset = <0>;
    multiplex-ratio = <63>;
    prechargep = <0x22>;
  };
};

&gpio0 {
  status = "okay";
};
